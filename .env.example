# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Main Gemini model to use for handwriting recognition and rubric evaluation.
# Defaults to "gemini-3.8-flash".
GEMINI_MODEL="gemini-3.8-flash"

# GEMINI_FALLBACK_MODELS: Optional comma-separated list of fallback models if primary model is unavailable.
# Defaults to "gemini-3.8-flash,gemini-3.1-pro-preview,gemini-flash-latest,gemini-3.1-flash-lite"
GEMINI_FALLBACK_MODELS="gemini-3.8-flash,gemini-3.1-pro-preview,gemini-flash-latest,gemini-3.1-flash-lite"

# GEMINI_THINKING_LEVEL: Optional thinking level for reasoning models (LOW, HIGH, or OFF).
# Defaults to "LOW" for gemini-3.8-flash.
GEMINI_THINKING_LEVEL="LOW"

# GEMINI_TEMPERATURE: Optional sampling temperature for model generation (e.g. 0.2).
GEMINI_TEMPERATURE="0.2"

# DEMO_OTP_CODE: Optional fixed verification code for SMS login tests (when empty, a random 4-digit code is generated per request).
DEMO_OTP_CODE=""

# FIREBASE_WEB_API_KEY: Required for server-side Firebase Auth REST API (email/password login & registration).
# Obtain from Firebase Console -> Project Settings -> General -> Web API Key.
FIREBASE_WEB_API_KEY="MY_FIREBASE_WEB_API_KEY"

# Optional client-side Firebase config (used when firebase-applet-config.json is omitted from Git)
VITE_FIREBASE_API_KEY="MY_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="MY_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="MY_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="MY_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="MY_FIREBASE_APP_ID"

# SMTP_* Settings: Required for sending PDF check reports to parents via email.
# For Gmail use smtp.gmail.com (port 465, SMTP_SECURE="true") and an App Password.
SMTP_HOST="MY_SMTP_HOST"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="MY_SMTP_USER"
SMTP_PASSWORD="MY_SMTP_PASSWORD"
SMTP_FROM="ТетрадьПлюс <MY_SMTP_USER>"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

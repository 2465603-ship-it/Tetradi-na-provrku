# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Main Gemini model to use for handwriting recognition and rubric evaluation.
# Defaults to "gemini-3.8-flash".
GEMINI_MODEL="gemini-3.8-flash"

# GEMINI_FALLBACK_MODELS: Optional comma-separated list of fallback models if primary model is unavailable.
# Defaults to "gemini-3.8-flash,gemini-3.1-pro-preview,gemini-flash-latest,gemini-3.1-flash-lite"
GEMINI_FALLBACK_MODELS="gemini-3.8-flash,gemini-3.1-pro-preview,gemini-flash-latest,gemini-3.1-flash-lite"

# GEMINI_THINKING_LEVEL: Optional thinking level for reasoning models (LOW, HIGH, or OFF).
# Defaults to "LOW" for gemini-3.8-flash.
GEMINI_THINKING_LEVEL="LOW"

# GEMINI_TEMPERATURE: Optional sampling temperature for model generation (e.g. 0.2).
GEMINI_TEMPERATURE="0.2"

# DEMO_OTP_CODE: Optional demo verification code for SMS login (defaults to 4825).
DEMO_OTP_CODE="4825"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
